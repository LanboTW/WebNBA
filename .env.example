# Copy to .env (git-ignored: never committed).

# Only for `npm run roster:update` with the balldontlie source. Secret: no VITE_ prefix, never reaches the page.
BALLDONTLIE_API_KEY=

# Supabase (career saves and sign-in). Project Settings -> API Keys / Data API.
# These two ARE built into the web page: the publishable key is meant to be public,
# row level security (supabase/schema.sql) keeps each player to their own saves.
# Never put the secret / service_role key here or anywhere in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
