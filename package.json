{
  "name": "webnba",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "roster:update": "npm run roster:update -w tools --",
    "logos:update": "npm run logos:update -w tools",
    "looks:fill": "npm run looks:fill -w tools",
    "ages:update": "npm run ages:update -w tools",
    "headshots:update": "npm run headshots:update -w tools --"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
